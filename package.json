{
  "name": "paynexus",
  "version": "2.0.0",
  "description": "Official PayNexus Node.js SDK — Accept M-Pesa payments, manage webhooks, and query merchants via the PayNexus API",
  "keywords": [
    "paynexus",
    "payment",
    "mpesa",
    "stk-push",
    "payment-gateway",
    "kenya",
    "mobile-money",
    "typescript",
    "m-pesa",
    "safaricom"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks/index.d.ts",
      "import": "./dist/webhooks/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PAYNEXUS-SOLUTIONS/paynexus",
    "directory": "paynexus-node-sdk"
  },
  "homepage": "https://www.paynexus.co.ke",
  "author": "PayNexus <support@paynexus.co.ke>",
  "bugs": {
    "url": "https://github.com/PAYNEXUS-SOLUTIONS/paynexus/issues"
  }
}
